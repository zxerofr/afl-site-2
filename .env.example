# Copy this file to ".env" and fill it in. Never commit the real .env.

# --- Server -------------------------------------------------------------
PORT=3000
# The public URL of the site, exactly as users type it (no trailing slash).
# Use https:// in production — cookies are only marked Secure when this starts with https://
BASE_URL=http://localhost:3000
# Set to 1 only when running behind a reverse proxy (nginx, Caddy, Cloudflare, Render, Railway…)
# so the real client IP is read from X-Forwarded-For.
TRUST_PROXY=0

# --- Discord OAuth2 (https://discord.com/developers/applications) ---------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI to register in the Discord portal:  <BASE_URL>/auth/discord/callback

# --- Access control ---------------------------------------------------
# The OWNER's Discord user ID (17–20 digits). The owner always has full access.
OWNER_DISCORD_ID=
# Optional: comma-separated Discord user IDs that are staff from first start-up.
# More staff can be added/removed later by the owner inside the staff portal.
STAFF_DISCORD_IDS=

# --- Storage ----------------------------------------------------------
DB_PATH=data/afl.db
UPLOAD_DIR=uploads

# --- Optional -----------------------------------------------------------
# Post a message to a Discord channel whenever a ticket is submitted.
DISCORD_WEBHOOK_URL=
SESSION_DAYS=14
# Set to 0 to stop the first-run catalogue seed (built from the supplied item images).
SEED_CATALOGUE=1
